DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
# Use Supabase's direct database URL for Prisma migrations/DDL when available.
# DIRECT_URL=
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_JWT_SECRET"
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="clearwork-razorpay-1712"
CORS_ORIGIN="http://localhost:5173"
PORT=3000
NODE_ENV="development"
# Email (GoDaddy SMTP — must match Fly.io secrets exactly)
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=465
EMAIL_USER=hello@getclearwork.in
EMAIL_PASS=
EMAIL_FROM="ClearWork <hello@getclearwork.in>"
# Admin panel (superadmin) — separate admin identity + own JWT (see feat/admin-panel)
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=8h
ADMIN_IMPERSONATION_SECRET=
ADMIN_IMPERSONATION_EXPIRES_IN=15m
# Optional admin seed credentials (never commit a real password)
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=change-me-before-running
# ADMIN_SEED_NAME=Demo Admin
# ADMIN_SEED_ROLE=SUPERADMIN
